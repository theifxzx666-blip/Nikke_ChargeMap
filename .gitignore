# ── 存储规范见 PROMPT.md §20 ────────────────────────────────────────────
# 四层：资源库/（输入） 分析/（中间） 正式产物/（交付） 工具/（代码）

# ── 资源库：只留场景卡与装配 JSON，重货不进 git ────────────────────────
# 原始 bundle（用 工具/采集/extract_*.py 从游戏客户端重新导出）
资源库/场景库/*/*/source/
# 采集中间物：提取出来的裸 bundle 与贴图（可重导）
资源库/共享依赖/原始bundle/
资源库/共享依赖/素材/
# 注：资源库/共享依赖/ 下的 5 个数据表 json、章节组/ 引擎件/ 的其他/
#     体积小（<10 MB）且有溯源价值，**保留入库**；bundle 本身由上面的 *.bundle 挡住
# 贴图（dump_textures.py 重新导出）
资源库/场景库/*/*/tex/
# glTF 场景（build_assembly.py + export_glb.py 重新生成，单图 8~15MB）
*.glb

# ── 分析：中间层保留（体积小、是结论），只挡一次性运行日志 ─────────────
分析/**/_run_*.json

# ── 正式产物：全部保留（页面 / 场景图 / 清单）─────────────────────────

# ── 游戏资源索引（从客户端复制）────────────────────────────────────────
*.cdb
*.cdb.idx
*.bundle
*.ab

# ── 临时与回收（草稿、历史产物、调试截图、一次性脚本）─────────────────
_work/
回收站/
临时车间/
log/

# ── 环境 ────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
Thumbs.db
desktop.ini
.DS_Store
